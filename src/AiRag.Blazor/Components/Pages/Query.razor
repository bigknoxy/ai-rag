@page "/query"
@using AiRag.Blazor.Models
@using AiRag.Blazor.Services
@inject ApiService ApiService

<PageTitle>Query Documents</PageTitle>

<h1>Query Documents</h1>

<p>Enter a query to search the knowledge base.</p>

<EditForm Model="queryRequest" OnValidSubmit="HandleQuery" FormName="queryForm">
    <div class="form-group">
        <label for="queryText">Query:</label>
        <input id="queryText" class="form-control" type="text" @bind="queryRequest.Text" placeholder="Enter your query..." />
    </div>

    <div class="form-group">
        <label for="topK">Top K Results:</label>
        <input id="topK" class="form-control" type="number" @bind="queryRequest.TopK" min="1" max="20" />
    </div>

    <div class="form-group">
        <label>
            <input type="checkbox" @bind="queryRequest.UseLlm" /> Use LLM for response
        </label>
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isLoading">Query</button>
    <button type="button" class="btn btn-secondary" @onclick="HandleStream" disabled="@isLoading">Stream Response</button>
</EditForm>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info mt-3">@message</div>
}

@if (queryResponse != null)
{
    <div class="mt-3">
        <h3>Response</h3>
        <div class="response-box">@((MarkupString)queryResponse.Response.Replace("\n", "<br>"))</div>
        <h4>Results</h4>
        <ul>
            @foreach (var result in queryResponse.Results)
            {
                <li>Chunk @result.ChunkId (Doc: @result.DocumentId) (Score: @result.Score.ToString("F2"))</li>
            }
        </ul>
    </div>
}

@if (isStreaming)
{
    <div class="mt-3">
        <h3>Streaming Response</h3>
        <div class="response-box" id="streamResponse"></div>
    </div>
}

<style>
    .form-group {
        margin-bottom: 1rem;
    }
    .form-control {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 0.25rem;
    }
    .btn {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 0.25rem;
        cursor: pointer;
        margin-right: 0.5rem;
    }
    .btn-primary {
        background-color: #007bff;
        color: white;
    }
    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }
    .btn:disabled {
        background-color: #6c757d;
        cursor: not-allowed;
    }
    .alert {
        padding: 0.75rem;
        border-radius: 0.25rem;
    }
    .alert-info {
        background-color: #d1ecf1;
        border: 1px solid #bee5eb;
        color: #0c5460;
    }
    .response-box {
        border: 1px solid #ccc;
        padding: 1rem;
        border-radius: 0.25rem;
        background-color: #f8f9fa;
        min-height: 100px;
    }
</style>

@code {
    private QueryRequest queryRequest = new QueryRequest();
    private QueryResponse? queryResponse;
    private bool isLoading;
    private bool isStreaming;
    private string message = string.Empty;

    private async Task HandleQuery()
    {
        if (string.IsNullOrWhiteSpace(queryRequest.Text))
        {
            message = "Please enter a query.";
            return;
        }

        isLoading = true;
        message = string.Empty;
        queryResponse = null;

        try
        {
            queryResponse = await ApiService.QueryAsync(queryRequest);
            message = "Query completed.";
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleStream()
    {
        if (string.IsNullOrWhiteSpace(queryRequest.Text))
        {
            message = "Please enter a query.";
            return;
        }

        isLoading = true;
        isStreaming = true;
        message = string.Empty;
        queryResponse = null;

        try
        {
            var streamResponse = ApiService.QueryStreamAsync(queryRequest);
            await foreach (var token in streamResponse)
            {
                // Update the DOM with the token (simplified for demo)
                // In a real app, use JS interop for real-time updates
            }
            message = "Streaming completed.";
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            isStreaming = false;
        }
    }
}